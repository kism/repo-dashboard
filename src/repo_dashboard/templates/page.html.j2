<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<style>{{ css }}</style>
</head>
<body>
<header>
  <h1>{{ title }}</h1>
  <p>{{ repos | length }} repos with CI, updated {{ generated }}</p>
</header>
<main>
{% for repo in repos %}
  <article>
    <h2><a href="{{ repo.url }}">{{ repo.name }}</a></h2>
    {% if repo.description %}
    <p>{{ repo.description | markdown }}</p>
    {% endif %}
    <div class="badges">
    {% for badge in repo.badges %}
      {%+ if badge.link %}<a href="{{ badge.link }}">{% endif -%}
      <img src="{{ badge.image }}" alt="{{ badge.alt }}" loading="lazy">
      {%- if badge.link %}</a>{% endif +%}
    {% endfor %}
    </div>
  </article>
{% endfor %}
</main>
<footer>Generated by <a href="{{ program_repo_url }}">repo-dashboard</a></footer>
</body>
</html>
