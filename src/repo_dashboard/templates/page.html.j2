<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>{{ favicon }}</text></svg>">
<style>{{ css }}</style>
</head>
<body>
<header>
  <h1>{{ title }}</h1>
  <p>{{ repos | length }} repos with CI, updated <time datetime="{{ generated }}">{{ generated }}</time></p>
</header>
<main>
{% for repo in repos %}
  <article>
    <h2><a href="{{ repo.url }}">{{ repo.name }}</a></h2>
    {% if repo.description %}
    <p>{{ repo.description | markdown }}</p>
    {% endif %}
    {% if repo.languages %}
    <div class="lang-bar">
    {% for lang in repo.languages %}
      <span style="flex: {{ lang.percent }}; background: {{ lang.color }}" title="{{ lang.name }} {{ '%.1f' | format(lang.percent) }}%"></span>
    {% endfor %}
    </div>
    <ul class="langs">
    {% for lang in repo.languages %}
      <li><span style="background: {{ lang.color }}"></span>{{ lang.name }} {{ '%.1f' | format(lang.percent) }}%</li>
    {% endfor %}
    </ul>
    {% endif %}
    <div class="badges">
    {% for badge in repo.badges %}
      {%+ if badge.link %}<a href="{{ badge.link }}">{% endif -%}
      <img src="{{ badge.image }}" alt="{{ badge.alt }}" loading="lazy">
      {%- if badge.link %}</a>{% endif +%}
    {% endfor %}
    </div>
  </article>
{% endfor %}
</main>
<footer>Generated by <a href="{{ program_repo_url }}">repo-dashboard</a></footer>
<script>
for (const t of document.querySelectorAll("time")) t.textContent = new Date(t.dateTime).toLocaleString();
</script>
</body>
</html>
